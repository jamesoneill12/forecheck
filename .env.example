# Copy to .env for local development. Never commit .env.
# Everything in the default quickstart runs with NONE of these set.

# --- Serving -----------------------------------------------------------------
FORECHECK_BACKEND=mock                 # mock | hf | rule_baseline
FORECHECK_MODEL_ID=                    # HF model id or local path when FORECHECK_BACKEND=hf
FORECHECK_ADAPTER_ID=                  # optional PEFT adapter id or path
FORECHECK_CALIBRATION_PATH=            # path to a CalibratorBundle json; unset = no probabilities returned
FORECHECK_POLICY_BUNDLE=conservative   # conservative | balanced | permissive | path to yaml
FORECHECK_DEVICE=auto                  # auto | cpu | cuda | mps
FORECHECK_HOST=0.0.0.0
FORECHECK_PORT=8000
FORECHECK_REQUEST_TIMEOUT_MS=5000
FORECHECK_MAX_BATCH=16
FORECHECK_LOG_LEVEL=info
FORECHECK_STORE_REQUEST_BODIES=false   # keep false in production
FORECHECK_AUTH_MODE=none               # none | static_token | header_passthrough
FORECHECK_STATIC_TOKEN=                # only when FORECHECK_AUTH_MODE=static_token
FORECHECK_OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Synthetic data generation (LLM renderers only; offline template mode needs none) -
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
FORECHECK_GEN_MAX_USD=5.00             # hard cost ceiling per pipeline run

# --- Training / experiment tracking -------------------------------------------
FORECHECK_TRACKING_BACKEND=local       # local (json files) | mlflow
MLFLOW_TRACKING_URI=
HF_TOKEN=                              # only for gated base models
